aws_region   = "us-east-1"
project_name = "tf-practice"

# Uncomment if you use a named AWS CLI profile instead of the default.
# aws_profile = "default"

# Uncomment and set to an existing key pair if you want SSH access.
# key_name         = "my-keypair"
# allowed_ssh_cidr = "x.x.x.x/32"

instance_type  = "t3.micro"
instance_count = 2

db_name           = "appdb"
db_username       = "appadmin"
db_instance_class = "db.t3.micro"
